[Unit]
Description=Telegram USDT/KRW price bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram_usdt_bot
EnvironmentFile=/opt/telegram_usdt_bot/.env
ExecStart=/opt/telegram_usdt_bot/venv/bin/python main.py
Restart=always
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
